<a href="{{ path }}" class="px-5 py-4 sm:px-7 sm:py-5 rounded-2xl border {{ theme == 'primary' ? 'bg-[#F4F8FF] border-blue-100' : 'bg-white border-gray-200' }} shadow-sm hover:shadow-md transition-all group flex items-center justify-between min-h-[90px] sm:min-h-[110px] gap-4">
    
    <div class="flex flex-col justify-center flex-1">
        <h4 class="text-[14px] sm:text-[16px] font-bold {{ theme == 'primary' ? 'text-blue-700' : 'text-gray-900' }} leading-tight">
            {{ title }}
        </h4>
        <p class="text-[12px] sm:text-[13px] {{ theme == 'primary' ? 'text-blue-500' : 'text-gray-500' }} mt-1 sm:mt-1.5 leading-snug">
            {{ subtitle }}
        </p>
    </div>

    <div class="{{ theme == 'primary' ? 'text-blue-600' : 'text-gray-400 group-hover:text-gray-600' }} text-sm sm:text-lg shrink-0">
        <i class="fa-solid fa-arrow-right"></i>
    </div>
    
</a>