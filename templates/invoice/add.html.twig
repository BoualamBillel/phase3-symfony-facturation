{% extends 'base.html.twig' %}

{% block title %}Créer une facture | FacturSaas{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto py-4">

    <a href="{{ path('app_invoice_index') }}"
        class="inline-flex items-center gap-2 text-[14px] text-gray-500 hover:text-gray-900 transition-colors mb-6 font-medium">
        <i class="fa-solid fa-arrow-left"></i> Retour aux factures
    </a>

    <h1 class="text-[28px] font-bold text-gray-900 tracking-tight mb-8">Créer une facture</h1>

    {{ form_start(form, {'attr': {'id': 'invoice-form'}}) }}

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 mb-8">
        <h2 class="text-lg font-bold text-gray-900 mb-6">Informations Générales</h2>

        <div class="grid grid-cols-2 gap-8">
            <div>
                {{ form_label(form.client, 'Client', {'label_attr': {'class': 'block text-[13px] font-medium text-gray-600 mb-2'}}) }}
                <div class="flex gap-2">
                    {{ form_widget(form.client, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-4 py-2.5 text-[14px] focus:ring-2 focus:ring-blue-100 outline-none shadow-sm bg-white'}}) }}

                    <a href="{{ path('app_client_add') }}"
                        class="inline-flex items-center justify-center px-4 py-2.5 border border-gray-300 rounded-lg text-gray-500 hover:bg-gray-50 transition-colors shadow-sm"
                        title="Créer un nouveau client">
                        <i class="fa-solid fa-plus"></i>
                    </a>
                </div>
            </div>

            <div>
                {{ form_label(form.invoiceDate, 'Date de la facture', {'label_attr': {'class': 'block text-[13px] font-medium text-gray-600 mb-2'}}) }}
                {{ form_widget(form.invoiceDate, {'attr': {'class': 'w-full border border-gray-300 rounded-lg px-4 py-2.5 text-[14px] focus:ring-2 focus:ring-blue-100 outline-none shadow-sm bg-white text-gray-700'}}) }}
            </div>
        </div>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 p-8 mb-8">
        <h2 class="text-lg font-bold text-gray-900 mb-6">Lignes de la facture</h2>

        <div class="w-full mb-8">
            <table class="w-full text-left border-collapse">
                <thead>
                    <tr class="border-b-2 border-gray-900 text-gray-900 text-[13px] font-bold">
                        <th class="pb-3 w-1/2">Produit / Service</th>
                        <th class="pb-3 w-24 text-center">Qté</th>
                        <th class="pb-3 w-32 text-right">Prix Unitaire</th>
                        <th class="pb-3 w-32 text-right">Total</th>
                        <th class="pb-3 w-10"></th>
                    </tr>
                </thead>

                <tbody id="invoice-lines-wrapper" class="divide-y divide-gray-100" data-index="0"
                    data-prototype="{{ include('invoice/_line_prototype.html.twig', { 'form': form.invoiceLines.vars.prototype })|e('html_attr') }}">

                    {% for lineForm in form.invoiceLines %}
                        {{ include('invoice/_line_prototype.html.twig', { 'form': lineForm }) }}
                    {% endfor %}
                </tbody>
            </table>
        </div>

        <div class="bg-gray-50/80 border border-gray-200 rounded-xl p-4 flex items-end gap-4 mb-8">
            <div class="flex-1">
                <label class="block text-[12px] font-medium text-gray-500 mb-1.5">Sélectionner un produit</label>
                <select id="temp-product-select"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-[14px] outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500 bg-white">
                    <option value="" data-price="" disabled></option>
                    {% for product in products %}
                        <option value="{{ product.name }}" data-price="{{ product.price }}">{{ product.name }}</option>
                    {% endfor %}
                </select>
            </div>
            <div class="w-24">
                <label class="block text-[12px] font-medium text-gray-500 mb-1.5">Quantité</label>
                <input type="number" id="temp-qty" value="1" min="1"
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-[14px] outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500">
            </div>
            <div class="w-32">
                <label class="block text-[12px] font-medium text-gray-500 mb-1.5">Prix unitaire (€)</label>
                <input type="number" id="temp-price" step="0.01" min="0" readonly
                    class="w-full border border-gray-300 rounded-lg px-3 py-2 text-[14px] outline-none focus:border-blue-500 focus:ring-1 focus:ring-blue-500"
                    placeholder="0.00">
            </div>
            <div>
                <button type="button" id="add-line-btn"
                    class="bg-gray-500 hover:bg-gray-600 text-white text-[14px] font-medium py-2 px-4 rounded-lg transition-colors flex items-center gap-2 shadow-sm h-[38px]">
                    <i class="fa-solid fa-plus"></i> Ajouter
                </button>
            </div>
        </div>

        <div class="flex justify-end items-center gap-6">
            <span class="text-[16px] font-bold text-gray-900">Total Facture (TTC) :</span>
            <span class="text-[22px] font-bold text-[#2563EB]" id="grand-total-display">0.00 €</span>
        </div>
    </div>

    <div class="flex justify-end items-center gap-3">
        <a href="{{ path('app_invoice_index') }}"
            class="px-5 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-700 text-[14px] font-medium hover:bg-gray-50 transition-colors shadow-sm">
            Annuler
        </a>

        <button type="submit" name="status" value="draft"
            class="px-5 py-2.5 bg-[#EFF6FF] border border-blue-200 text-blue-700 rounded-lg text-[14px] font-medium hover:bg-blue-100 transition-colors shadow-sm">
            Enregistrer en brouillon
        </button>

        <button type="submit" name="status" value="validated"
            class="px-6 py-2.5 bg-[#2563EB] hover:bg-blue-700 text-white rounded-lg text-[14px] font-medium transition-colors shadow-sm">
            Enregistrer et valider
        </button>
    </div>

    <div class="hidden">
        {{ form_rest(form) }}
    </div>

    {{ form_end(form) }}
</div>

<script>
    document.addEventListener('DOMContentLoaded', function () {
        const wrapper = document.getElementById('invoice-lines-wrapper');
        const addButton = document.getElementById('add-line-btn');
        const totalDisplay = document.getElementById('grand-total-display');

        const tempProductSelect = document.getElementById('temp-product-select');
        const tempQty = document.getElementById('temp-qty');
        const tempPrice = document.getElementById('temp-price');

        tempProductSelect.addEventListener('change', function () {
            const selectedOption = this.options[this.selectedIndex];
            const price = selectedOption.getAttribute('data-price');
            if (price) {
                tempPrice.value = parseFloat(price).toFixed(2);
            } else {
                tempPrice.value = '';
            }
        });

        addButton.addEventListener('click', function () {
            const productName = tempProductSelect.value;

            if (!productName || !tempPrice.value) {
                alert('Veuillez sélectionner une prestation et vérifier son prix.');
                return;
            }

            let prototype = wrapper.dataset.prototype;
            let index = parseInt(wrapper.dataset.index);

            let newForm = prototype.replace(/__name__/g, index);
            wrapper.dataset.index = index + 1;

            const tr = document.createElement('tr');
            tr.className = 'line-item group border-b border-gray-50 hover:bg-gray-50/50 transition-colors';
            tr.innerHTML = newForm;
            wrapper.appendChild(tr);

            tr.querySelector('.input-name').value = productName;
            tr.querySelector('.input-qty').value = tempQty.value;
            tr.querySelector('.input-price').value = parseFloat(tempPrice.value).toFixed(2);

            tr.querySelector('.display-name').textContent = productName;
            tr.querySelector('.display-qty').textContent = tempQty.value;
            tr.querySelector('.display-price').textContent = parseFloat(tempPrice.value).toFixed(2) + ' €';

            tempProductSelect.value = '';
            tempQty.value = '1';
            tempPrice.value = '';
            tempProductSelect.focus();

            calculateTotals();
        });

        wrapper.addEventListener('click', function (e) {
            const removeBtn = e.target.closest('.remove-line-btn');
            if (removeBtn) {
                removeBtn.closest('.line-item').remove();
                calculateTotals();
            }
        });

        function calculateTotals() {
            let grandTotal = 0;

            document.querySelectorAll('.line-item').forEach(function (line) {
                const price = parseFloat(line.querySelector('.input-price').value) || 0;
                const qty = parseInt(line.querySelector('.input-qty').value) || 0;
                const lineTotal = price * qty;
                grandTotal += lineTotal;

                const displayTotal = line.querySelector('.line-total-display');
                if (displayTotal) {
                    displayTotal.textContent = lineTotal.toFixed(2) + ' €';
                }
            });

            totalDisplay.textContent = grandTotal.toFixed(2) + ' €';
        }
    });
</script>
{% endblock %}