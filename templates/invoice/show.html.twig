{% extends 'base.html.twig' %}

{% block title %}Facture {{ invoice.number|default('Brouillon') }} | FacturSaas{% endblock %}

{% block body %}
<div class="max-w-5xl mx-auto py-8">

    <div class="mb-8 no-print">
        <a href="{{ path('app_invoice_index') }}"
            class="inline-flex items-center gap-2 text-[14px] text-gray-500 hover:text-gray-900 transition-colors font-medium">
            <i class="fa-solid fa-arrow-left"></i> Retour aux factures
        </a>
    </div>

    <div class="flex justify-between items-start mb-8 no-print">
        <div>
            <div class="flex items-center gap-3 mb-2">
                <h1 class="text-[24px] font-bold text-gray-900 tracking-tight">
                    Facture {{ invoice.number ? invoice.number : 'Sans numéro' }}
                </h1>

                {% if invoice.status == 'draft' %}
                <span
                    class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-gray-50 text-gray-600 text-[12px] font-medium border border-gray-200">
                    <i class="fa-regular fa-clock"></i> Brouillon
                </span>
                {% elseif invoice.status == 'validated' %}
                <span
                    class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-orange-50 text-orange-700 text-[12px] font-medium border border-orange-200">
                    <i class="fa-regular fa-clock"></i> En attente
                </span>
                {% elseif invoice.status == 'paid' %}
                <span
                    class="inline-flex items-center gap-1.5 px-2.5 py-1 rounded-md bg-green-50 text-green-700 text-[12px] font-medium border border-green-200">
                    <i class="fa-regular fa-circle-check"></i> Payée
                </span>
                {% endif %}
            </div>
            <p class="text-[14px] text-gray-500">
                Date: {{ invoice.invoiceDate ? invoice.invoiceDate|date('d/m/Y') : invoice.createdAt|date('d/m/Y') }}
            </p>
        </div>

        <div class="flex gap-3">
            {% if invoice.status == 'draft' %}

            <a href="{{ path('app_invoice_edit', {'id': invoice.id}) }}"
                class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg text-[14px] font-medium hover:bg-gray-50 transition-colors inline-flex items-center gap-2 shadow-sm">
                <i class="fa-solid fa-pen-to-square"></i> Modifier
            </a>

            <form action="{{ path('app_invoice_validate', {'id': invoice.id}) }}" method="POST"
                onsubmit="return confirm('Voulez-vous vraiment valider cette facture ? Elle ne pourra plus être modifiée.');">
                <button type="submit"
                    class="px-4 py-2 bg-[#D1FADF] hover:bg-[#A6F4C5] text-[#039855] border border-[#A6F4C5] rounded-lg text-[14px] font-medium transition-colors inline-flex items-center gap-2 shadow-sm">
                    <i class="fa-solid fa-check"></i> Valider la facture
                </button>
            </form>

            <form action="{{ path('app_invoice_delete', {'id': invoice.id}) }}" method="POST"
                onsubmit="return confirm('Voulez-vous vraiment supprimer ce document ?');">
                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ invoice.id) }}">
                <button type="submit"
                    class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg text-[14px] font-medium hover:bg-red-50 hover:text-red-600 hover:border-red-200 transition-colors inline-flex items-center gap-2 shadow-sm">
                    <i class="fa-regular fa-trash-can"></i> Supprimer
                </button>
            </form>

            {% elseif invoice.status == 'validated' %}

            <button onclick="window.print()"
                class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg text-[14px] font-medium hover:bg-gray-50 transition-colors inline-flex items-center gap-2 shadow-sm">
                <i class="fa-regular fa-file-pdf"></i> PDF
            </button>

            <form action="{{ path('app_invoice_send', {'id': invoice.id}) }}" method="POST">
                <button type="submit"
                    class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg text-[14px] font-medium hover:bg-gray-50 transition-colors inline-flex items-center gap-2 shadow-sm">
                    <i class="fa-regular fa-paper-plane"></i> Envoyer
                </button>
            </form>

            <form action="{{ path('app_invoice_pay', {'id': invoice.id}) }}" method="POST"
                onsubmit="return confirm('Confirmer la réception du paiement pour cette facture ?');">
                <button type="submit"
                    class="px-4 py-2 bg-[#D1FADF] hover:bg-[#A6F4C5] text-[#039855] border border-[#A6F4C5] rounded-lg text-[14px] font-medium transition-colors inline-flex items-center gap-2 shadow-sm">
                    <i class="fa-solid fa-euro-sign"></i> Valider le paiement
                </button>
            </form>

            {% elseif invoice.status == 'paid' %}

            <button onclick="window.print()"
                class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg text-[14px] font-medium hover:bg-gray-50 transition-colors inline-flex items-center gap-2 shadow-sm">
                <i class="fa-solid fa-download"></i> Télécharger / PDF
            </button>

            <form action="{{ path('app_invoice_send', {'id': invoice.id}) }}" method="POST">
                <button type="submit"
                    class="px-4 py-2 bg-white border border-gray-300 text-gray-700 rounded-lg text-[14px] font-medium hover:bg-gray-50 transition-colors inline-flex items-center gap-2 shadow-sm">
                    <i class="fa-regular fa-paper-plane"></i> Envoyer
                </button>
            </form>

            {% endif %}
        </div>
    </div>

    <div
        class="bg-white rounded-2xl shadow-sm border border-gray-200 p-12 print:border-none print:shadow-none print:p-0 print:m-0">

        <div class="flex justify-between items-start mb-12">
            <div>
                <h2 class="text-[18px] font-bold text-gray-900 mb-1">{{ app.user.companyName }}</h2>
                <div class="text-[14px] text-gray-500 leading-relaxed">
                    <p>{{ app.user.email }}</p>
                    <p>SIRET: 123 456 789 00012</p>
                </div>
            </div>
            <div class="text-right">
                <h2 class="text-[20px] font-bold text-gray-900 mb-2 tracking-wide uppercase">Facture</h2>
                <div class="text-[14px] text-gray-500 leading-relaxed">
                    <p>N° {{ invoice.number ? invoice.number : 'Brouillon' }}</p>
                    <p>Date : {{ invoice.invoiceDate ? invoice.invoiceDate|date('d/m/Y') :
                        invoice.createdAt|date('d/m/Y') }}</p>
                </div>
            </div>
        </div>

        <div class="flex justify-end mb-16">
            <div class="bg-gray-50 rounded-xl p-6 w-[400px] print:bg-gray-50 print:!border print:!border-gray-200"
                style="-webkit-print-color-adjust: exact; print-color-adjust: exact;">
                <p class="text-[11px] font-semibold text-gray-400 uppercase tracking-wider mb-2">Facturé à</p>
                <div class="text-[14px]">
                    {% if invoice.client %}
                    <p class="text-[16px] font-bold text-gray-900 mb-2">{{ invoice.client.name }}</p>
                    {% if invoice.client.address %}
                    <p class="text-gray-600 mb-1">{{ invoice.client.address }}</p>
                    {% endif %}
                    {% if invoice.client.siret %}
                    <p class="text-gray-500 text-[13px] mt-2">SIRET : {{ invoice.client.siret }}</p>
                    {% endif %}
                    <p class="text-gray-600 mb-1">{{ invoice.client.email|default('Aucun email') }}</p>
                    {% else %}
                    <p class="text-red-500 italic">Client introuvable</p>
                    {% endif %}
                </div>
            </div>
        </div>

        <table class="w-full text-left mb-12">
            <thead>
                <tr class="border-b-2 border-gray-900">
                    <th class="pb-3 text-[14px] font-bold text-gray-900">Description</th>
                    <th class="pb-3 text-[14px] font-bold text-gray-900 text-center w-24">Qté</th>
                    <th class="pb-3 text-[14px] font-bold text-gray-900 text-right w-32">Prix Unitaire</th>
                    <th class="pb-3 text-[14px] font-bold text-gray-900 text-right w-32">Total TTC</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% for line in invoice.invoiceLines %}
                <tr>
                    <td class="py-5">
                        <p class="text-[14px] text-gray-900 font-medium">{{ line.productName }}</p>
                    </td>
                    <td class="py-5 text-center text-[14px] text-gray-900">{{ line.quantity }}</td>
                    <td class="py-5 text-right text-[14px] text-gray-900">{{ line.unitPrice|number_format(2, '.', ' ')
                        }} €</td>
                    <td class="py-5 text-right text-[14px] font-bold text-gray-900">{{ line.total|number_format(2, '.',
                        ' ') }} €</td>
                </tr>
                {% else %}
                <tr>
                    <td colspan="4" class="py-6 text-center text-gray-500 italic">Aucune ligne facturée.</td>
                </tr>
                {% endfor %}
            </tbody>
        </table>

        <div class="flex justify-end mb-16">
            <div class="w-[300px]">
                <div class="flex justify-between py-2 text-[14px] text-gray-600">
                    <span>Total HT</span>
                    <span>{{ invoice.totalAmount|number_format(2, '.', ' ') }} €</span>
                </div>

                <div class="flex justify-between py-3 border-t-2 border-gray-900 mt-2 mb-1">
                    <span class="text-[16px] font-bold text-gray-900">Total TTC</span>
                    <span class="text-[18px] font-bold text-[#2563EB]">{{ invoice.totalAmount|number_format(2, '.', ' ')
                        }} €</span>
                </div>

                <p class="text-right text-[11px] text-gray-500">TVA non applicable, art. 293 B du CGI</p>
            </div>
        </div>

        <div class="mt-8 pt-8 border-t border-gray-100">
            <p class="text-[14px] text-gray-900 mb-3 font-medium">Conditions de paiement</p>
            <div class="bg-gray-50 rounded-xl p-5 border border-gray-100 print:bg-gray-50 print:!border print:!border-gray-200"
                style="-webkit-print-color-adjust: exact; print-color-adjust: exact;">
                <p class="text-[13px] text-gray-600 mb-1">Coordonnées bancaires pour le paiement :</p>
                <p class="text-[14px] font-mono text-gray-700 tracking-widest font-semibold">FR76 1234 5678 9012 3456
                    7890 123</p>
            </div>
        </div>

    </div>
</div>

<style>
    @media print {
        body {
            background-color: white !important;
        }

        .no-print,
        nav,
        header,
        aside {
            display: none !important;
        }

        .max-w-5xl {
            max-width: 100% !important;
            margin: 0 !important;
            padding: 0 !important;
        }

        @page {
            margin: 1cm;
        }
    }
</style>
{% endblock %}