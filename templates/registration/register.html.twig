{% extends 'base.html.twig' %}

{% block title %}Créer votre compte{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#fafafa] flex flex-col justify-center items-center py-12 px-4 sm:px-6 lg:px-8 font-sans">
    
    <div class="sm:mx-auto sm:w-full sm:max-w-md text-center mb-8">
        <div class="w-12 h-12 bg-blue-600 text-white rounded-lg flex items-center justify-center mx-auto mb-6">
            <i class="fa-solid fa-file-invoice-dollar text-2xl"></i>
        </div>
        <h2 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Créez votre compte</h2>
        <p class="text-sm text-gray-600">
            Ou <a href="{{ path('app_login') }}" class="font-medium text-blue-600 hover:text-blue-500 transition-colors">connectez-vous à votre compte</a>
        </p>
    </div>

    <div class="sm:mx-auto sm:w-full sm:max-w-[500px]">
        <div class="bg-white py-8 px-6 sm:px-10 border border-gray-200 rounded-xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
            
            {{ form_start(registrationForm, {'attr': {'class': 'space-y-5'}}) }}
                
                <div class="grid grid-cols-2 gap-4">
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Prénom</label>
                        {{ form_widget(registrationForm.firstName, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-600 focus:border-blue-600', 'placeholder': '...'}}) }}
                        <div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.firstName) }}</div>
                    </div>
                    <div>
                        <label class="block text-sm font-medium text-gray-700 mb-1">Nom</label>
                        {{ form_widget(registrationForm.lastName, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-600 focus:border-blue-600', 'placeholder': '...'}}) }}
                        <div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.lastName) }}</div>
                    </div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Raison Sociale</label>
                    {{ form_widget(registrationForm.companyName, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-600 focus:border-blue-600', 'placeholder': 'Tech Solutions'}}) }}
                    <div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.companyName) }}</div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">IBAN</label>
                    {{ form_widget(registrationForm.iban, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-600 focus:border-blue-600', 'placeholder': 'FR76 1234 5678 9012 3456 7890 123'}}) }}
                    <div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.iban) }}</div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Adresse Email</label>
                    {{ form_widget(registrationForm.email, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-600 focus:border-blue-600', 'placeholder': 'contact@entreprise.fr'}}) }}
                    <div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.email) }}</div>
                </div>

                <div>
                    <label class="block text-sm font-medium text-gray-700 mb-1">Mot de passe</label>
                    {{ form_widget(registrationForm.plainPassword, {'attr': {'class': 'w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-600 focus:border-blue-600', 'placeholder': '••••••••'}}) }}
                    <div class="text-red-500 text-xs mt-1">{{ form_errors(registrationForm.plainPassword) }}</div>
                </div>

                <div class="pt-2">
                    <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                        Créer mon compte
                    </button>
                </div>

            {{ form_end(registrationForm) }}
        </div>
    </div>
</div>
{% endblock %}