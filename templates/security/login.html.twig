{% extends 'base.html.twig' %}

{% block title %}Connexion{% endblock %}

{% block body %}
<div class="min-h-screen bg-[#fafafa] flex flex-col justify-center items-center py-12 px-4 sm:px-6 lg:px-8 font-sans">
    
    <div class="sm:mx-auto sm:w-full sm:max-w-md text-center mb-8">
        <div class="w-12 h-12 bg-blue-600 text-white rounded-lg flex items-center justify-center mx-auto mb-6">
            <i class="fa-solid fa-file-invoice-dollar text-2xl"></i>
        </div>
        <h2 class="text-3xl font-bold text-gray-900 tracking-tight mb-2">Connectez-vous</h2>
        <p class="text-sm text-gray-600">
            Ou <a href="{{ path('app_register') }}" class="font-medium text-blue-600 hover:text-blue-500 transition-colors">créez un compte gratuitement</a>
        </p>
    </div>

    <div class="sm:mx-auto sm:w-full sm:max-w-[450px]">
        <div class="bg-white py-8 px-6 sm:px-10 border border-gray-200 rounded-xl shadow-[0_2px_10px_-3px_rgba(6,81,237,0.1)]">
            
            <form method="post" class="space-y-5">
                
                {% if error %}
                    <div class="bg-red-50 text-red-500 p-3 rounded-md text-sm border border-red-200">
                        {{ error.messageKey|trans(error.messageData, 'security') }}
                    </div>
                {% endif %}

                <div>
                    <label for="username" class="block text-sm font-medium text-gray-700 mb-1">Adresse Email</label>
                    <input type="email" value="{{ last_username }}" name="_username" id="username" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-600 focus:border-blue-600" autocomplete="email" placeholder="contact@entreprise.fr" required autofocus>
                </div>

                <div>
                    <label for="password" class="block text-sm font-medium text-gray-700 mb-1">Mot de passe</label>
                    <input type="password" name="_password" id="password" class="w-full px-3 py-2 border border-gray-300 rounded-md text-sm focus:outline-none focus:ring-1 focus:ring-blue-600 focus:border-blue-600" autocomplete="current-password" placeholder="••••••••" required>
                </div>

                <input type="hidden" name="_csrf_token" value="{{ csrf_token('authenticate') }}">

                <div class="pt-2">
                    <button type="submit" class="w-full flex justify-center py-2.5 px-4 border border-transparent rounded-md shadow-sm text-sm font-medium text-white bg-blue-600 hover:bg-blue-700 focus:outline-none focus:ring-2 focus:ring-offset-2 focus:ring-blue-500 transition-colors">
                        Se connecter
                    </button>
                </div>
                
            </form>
        </div>
    </div>
</div>
{% endblock %}