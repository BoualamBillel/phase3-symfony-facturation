{% extends 'base.html.twig' %}

{% block title %}Produits & Services | FacturSaas{% endblock %}

{% block body %}
    
    <div class="flex justify-between items-center mb-8">
        <h1 class="text-[28px] font-bold text-gray-900 tracking-tight">Produits & Services</h1>
        
        <a href="{{ path('app_product_add') }}" class="bg-[#2563EB] hover:bg-blue-700 text-white text-[14px] font-medium py-2 px-5 rounded-lg transition-colors shadow-sm flex items-center gap-2">
            <i class="fa-solid fa-plus"></i>
            Ajouter un produit
        </a>
    </div>

    <div class="bg-white rounded-xl shadow-sm border border-gray-200 overflow-hidden">
        <table class="w-full text-left border-collapse">
            <thead>
                <tr class="border-b border-gray-200 bg-gray-50/50 text-gray-900 text-[13px] font-bold">
                    <th class="px-6 py-4">Nom</th>
                    <th class="px-6 py-4">Description</th>
                    <th class="px-6 py-4">Prix unitaire</th>
                    <th class="px-6 py-4 text-right">Actions</th>
                </tr>
            </thead>
            <tbody class="divide-y divide-gray-100">
                {% set unit_translations = {
                    'piece': 'pièce',
                    'hour': 'heure',
                    'day': 'jour',
                    'month': 'mois',
                    'year': 'an'
                } %}

                {% for product in products %}
                    <tr class="hover:bg-gray-50 transition-colors group">
                        <td class="px-6 py-4 text-[14px] text-gray-900 font-medium">{{ product.name }}</td>
                        <td class="px-6 py-4 text-[14px] text-gray-500 max-w-md truncate">{{ product.description }}</td>
                        <td class="px-6 py-4 text-[14px] text-gray-900">
                            {{ product.price|number_format(2, ',', ' ') }} € / {{ unit_translations[product.unit]|default(product.unit) }}
                        </td>
                        <td class="px-6 py-4 text-right">
                            <div class="flex items-center justify-end gap-4 opacity-0 group-hover:opacity-100 transition-opacity">
                                
                                <a href="{{ path('app_product_edit', {'id': product.id}) }}" class="text-blue-500 hover:text-blue-700 transition-colors" title="Modifier">
                                    <i class="fa-solid fa-pen"></i>
                                </a>
                                
                                <button type="button" onclick="document.getElementById('delete-modal-{{ product.id }}').showModal()" class="text-red-500 hover:text-red-700 transition-colors" title="Supprimer">
                                    <i class="fa-solid fa-trash-can"></i>
                                </button>

                                <dialog id="delete-modal-{{ product.id }}" class="bg-transparent p-0 backdrop:bg-gray-900/40 backdrop:backdrop-blur-sm rounded-xl m-auto open:animate-in open:fade-in open:zoom-in-95 duration-200 text-left">
                                    <div class="bg-white rounded-2xl p-6 max-w-sm w-full text-center shadow-2xl border border-gray-100">
                                        
                                        <div class="w-12 h-12 rounded-full bg-red-50 text-red-500 flex items-center justify-center mx-auto mb-4">
                                            <i class="fa-solid fa-triangle-exclamation text-xl"></i>
                                        </div>
                                        
                                        <h3 class="text-lg font-bold text-gray-900 mb-2">Supprimer la prestation</h3>
                                        <p class="text-[14px] text-gray-500 mb-6">Êtes-vous sûr de vouloir supprimer <strong>{{ product.name }}</strong> ? Cette action est irréversible.</p>
                                        
                                        <div class="flex gap-3 w-full">
                                            <button type="button" onclick="this.closest('dialog').close()" class="flex-1 px-4 py-2.5 bg-white border border-gray-300 rounded-lg text-gray-700 text-[14px] font-medium hover:bg-gray-50 transition-colors">
                                                Annuler
                                            </button>
                                            
                                            <form method="post" action="{{ path('app_product_delete', {'id': product.id}) }}" class="flex-1 m-0">
                                                <input type="hidden" name="_token" value="{{ csrf_token('delete' ~ product.id) }}">
                                                <button type="submit" class="w-full px-4 py-2.5 bg-red-600 hover:bg-red-700 text-white rounded-lg text-[14px] font-medium transition-colors shadow-sm">
                                                    Supprimer
                                                </button>
                                            </form>
                                        </div>

                                    </div>
                                </dialog>

                            </div>
                        </td>
                    </tr>
                {% else %}
                    <tr>
                        <td colspan="4" class="px-6 py-12 text-center text-gray-500">
                            <div class="w-16 h-16 bg-blue-50 text-blue-500 rounded-full flex items-center justify-center mx-auto mb-4 text-2xl">
                                <i class="fa-solid fa-box-open"></i>
                            </div>
                            <h3 class="text-gray-900 text-lg font-medium mb-2">Aucun produit</h3>
                            <p class="text-sm max-w-sm mx-auto mb-6">Votre catalogue est vide. Ajoutez des prestations pour les facturer.</p>
                        </td>
                    </tr>
                {% endfor %}
            </tbody>
        </table>
    </div>

{% endblock %}