{% extends 'base.html.twig' %}

{% block title %}Dashboard | FacturSaas{% endblock %}

{% block body %}

<header class="mb-8">
    <h1 class="text-[28px] font-bold text-gray-900 tracking-tight">Dashboard</h1>
</header>


<div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-4 gap-6 mb-8">
    <twig:StatCard label="Chiffre d'affaires (Payé)" value="TEST" icon="fa-solid fa-euro-sign"
        color="bg-emerald-100 text-emerald-600" />
    <twig:StatCard label="Factures en attente" value="TEST" icon="fa-solid fa-file-invoice"
        color="bg-orange-100 text-orange-500" />
    <twig:StatCard label="Total Clients" value="TEST" icon="fa-solid fa-users" color="bg-blue-100 text-blue-500" />
    <twig:StatCard label="Total Produits" value="TEST" icon="fa-solid fa-box" color="bg-purple-100 text-purple-500" />
</div>

{# TODO GRAPHIQUE #}
<div class="h-50 flex items-center justify-center">
    <h1>EMPLACEMENT DU GRAPHIQUE</h1>
</div>

<div class="grid grid-cols-1 lg:grid-cols-3 gap-6 mb-8">
    <twig:ActionCard title="Créer une facture" subtitle="Nouvelle prestation" path="#" theme="primary" />

    <twig:ActionCard title="Ajouter un client" subtitle="Gérer le répertoire" path="#" />

    <twig:ActionCard title="Créer un produit / service"
        subtitle="Enrichir le catalogue pour rediger rapidement vos factures" path="#" />

    <twig:ActionCard title="Relancer tous les clients"
        subtitle="Envoyer un mail à tous les clients en retard de paiement" path="#" />
</div>


{% endblock %}